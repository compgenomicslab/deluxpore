/* ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ktlina/demultiplexer Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

manifest {
    author = 'Catalina Arnaiz'
    name = 'deluxepore'
    description = 'Nanopore-Illumina library based demultiplexing pipeline'
    homePage = 'https://github.com/ktlina/deluxpore'
    mainScript = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version = '1.0.0'
}

params {
    /* Input and output options */
    projectName = null
    readsDir = null
    readsFileExtension = null
    experimentalDesign = null
    outDir = './results'

    /* Nanopore trimming and filtering options */
    trimandfilterNanopore = true
    nanoQscore = 20
    nanoLength = 100

    /* Terminal Illumina-adapter trimming, per sample, after demultiplexing.
       Independent of chimera detection below. */
    trimmIlluminaIndexes = false

    /* Chimera detection always runs, before demultiplexing, on the raw reads --
       so a chimeric read's fragments each carry only their own sample's i5/i7
       pair into assignment instead of the whole read being excluded as an
       invalid cross-sample combination. Detection is always reported in
       chimera_reads.tsv; set removeChimeras to true to actually split reads at
       the detected junctions rather than just flagging them. */
    removeChimeras = false
    removeChimerasCoverage = 0.7

    /* RC collision withholding threshold */
    rcCollisionWithholdDist = 0

    /* Maximum accepted Levenshtein distance for a same-slot barcode match.
       Absolute edit distance, not relative to barcode length -- tune per
       index kit (e.g. a 10bp kit can likely tolerate a looser value than an
       8bp kit at the same relative stringency). */
    maxBarcodeMatchDist = 2

    /* Dual-confirmation rescue: promotes a read that fails maxBarcodeMatchDist
       in BOTH slots if its two individually-too-loose candidates (one per
       slot, up to rescueMaxDist) agree on a real, valid sample pair. Off by
       default -- opt in explicitly. rescueMaxDist defaults to
       maxBarcodeMatchDist + 1 when left null. */
    rescueBarcodeMatch = false
    rescueMaxDist = null

    /* Illumina index seqs used for library construction */
    libraryIndexSeqs = null
    customIlluminaLibrary = null

    /* Resource limits - auto-detect by default */
    max_cpus = Runtime.runtime.availableProcessors()
    max_memory = '16 GB'

    /* Conda environment - null uses environment.yml, or provide path to pre-built env */
    conda_env = null

    /* Copy all intermediate files or just final results*/
    publishIntermediate = false

    help = false
    version = false
}

/* 
----------------------------------------------------------------------------------------
    Base process configuration
----------------------------------------------------------------------------------------
*/

process {
    cpus = { Math.min(task.cpus ?: 1, params.max_cpus as int) }
    memory = { 
        def requested = task.memory ?: 4.GB
        def maxMem = params.max_memory as nextflow.util.MemoryUnit
        return requested > maxMem ? maxMem : requested
    }
    errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'finish' }
    maxRetries = 3

    conda = params.conda_env ?: "${projectDir}/envs/deluxpore.yml"

}

/* 
----------------------------------------------------------------------------------------
    Profiles
----------------------------------------------------------------------------------------
*/

profiles {

    conda {
        conda.enabled = true
        conda.useMamba = true
        conda.cacheDir = "${HOME}/.nextflow_conda"
    }

    local {
        process.beforeScript = 'eval "$(conda shell.bash hook)"'
        includeConfig 'config/local.config'
    }

    slurm {
        process.beforeScript = 'eval "$(conda shell.bash hook)"'
        params.max_memory = '128 GB'
        params.max_cpus = 32
        includeConfig 'config/slurm.config'
    }
}